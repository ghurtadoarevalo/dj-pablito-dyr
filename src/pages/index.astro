---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.tsx";
import Hero from "@components/Hero.astro";
import Bio from "@components/Bio.astro";
import Services from "@components/Services.astro";
import Videos from "@components/Videos.astro";
import Footer from "@components/Footer.astro";
import Contact from "@components/Contact.tsx";
import Testimonials from "@components/Testimonials.astro";
import CallToAction from "@components/CallToAction.astro";
import Eventos from "@components/Eventos.astro";
import Equipments from "@components/Equipments.astro";
import FAQ from "@components/FAQ.astro";
---

<Layout
  title="DJ Pablito Dyr"
  description="DJ profesional en Santiago y Maipú. Servicio de DJ, animación, karaoke, iluminación y sonido para matrimonios, cumpleaños y eventos corporativos."
>
  <Navbar client:load />
  <main class="pt-16 text-paper">
    <Hero />
    <Testimonials />
    <Videos />
    <Services />
    <CallToAction />
    <Equipments />
    <Eventos />
    <FAQ />
    <Bio />
  </main>
  <Contact client:load />
  <Footer />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
