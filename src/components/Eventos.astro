---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import bodas from "@assets/eventos/bodas-de-oro.jpg";
import cumple from "@assets/eventos/cumpleanos-calera.jpg";
import privada from "@assets/eventos/fiesta-privada.jpg";
import evento1 from "@assets/eventos/evento-1.jpg";
import evento2 from "@assets/eventos/evento-2.jpg";

const photos = [
  { src: bodas, alt: "Bodas de oro con pista de baile montada" },
  { src: cumple, alt: "Cumpleaños en Calera de Tango con animación" },
  { src: privada, alt: "Fiesta privada con luces y sonido profesional" },
  { src: evento1, alt: "Evento con DJ, animación e iluminación" },
  { src: evento2, alt: "Montaje de sonido e iluminación en un evento" },
];
---

<section
  id="eventos"
  aria-labelledby="eventos-title"
  class="reveal overflow-hidden border-t border-line bg-ink py-16 md:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="eventos-title"
      kicker="Eventos reales"
      title="Así se ve"
      lead="Fotos de fiestas que ya pasaron: matrimonios, cumpleaños y eventos privados."
    />
  </div>

  <ul
    class="mt-10 flex gap-3 overflow-x-auto px-4 pb-2 sm:px-6 md:gap-4 lg:grid lg:grid-cols-5 lg:px-8"
  >
    {
      photos.map((photo) => (
        <li class="w-56 shrink-0 lg:w-auto">
          <Image
            src={photo.src}
            alt={photo.alt}
            width={540}
            height={675}
            loading="lazy"
            class="h-72 w-full rounded-card border border-line object-cover transition duration-reveal ease-reveal hover:border-line-strong lg:h-96"
          />
        </li>
      ))
    }
  </ul>
</section>
