---
import SectionHeading from "./SectionHeading.astro";

interface Reel {
  code: string;
  title: string;
}

const reels: Reel[] = [
  { code: "DezQqZBRO4N", title: "Bodas de oro con DJ y animación" },
  { code: "DT80j5IEZOl", title: "Cumpleaños en Calera de Tango" },
  { code: "DX69tN_xYuq", title: "Fiesta privada con sonido e iluminación" },
  { code: "DbybB_sRG1z", title: "Evento municipal en Teatro Oriente" },
];
---

<section
  id="eventos"
  aria-labelledby="eventos-title"
  class="reveal border-t border-line bg-ink py-16 md:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      number="02"
      id="eventos-title"
      kicker="Eventos reales"
      title="Así se ve"
      lead="Reels de fiestas que ya pasaron, directo desde nuestro Instagram."
    />
  </div>

  <ul
    class="no-scrollbar mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:px-6 lg:grid lg:grid-cols-2 lg:px-8 xl:grid-cols-4"
  >
    {
      reels.map((reel) => (
        <li class="w-[240px] shrink-0 snap-start lg:w-auto">
          <iframe
            src={`https://www.instagram.com/reel/${reel.code}/embed/`}
            title={reel.title}
            class="h-[420px] w-full rounded-card border border-line bg-surface"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
            allowtransparency="true"
            frameborder="0"
            scrolling="no"
          />
        </li>
      ))
    }
  </ul>

  <p
    class="mx-auto mt-4 max-w-7xl px-4 text-[10px] font-bold uppercase tracking-wide text-muted sm:px-6 lg:px-8"
  >
    Los videos se reproducen dentro de Instagram. Si no cargan, revisá el
    bloqueador de contenido.
  </p>
</section>
