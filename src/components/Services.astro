---
import ServicesSection from "./ServicesSection";
import { SERVICE_PLANS } from "../data/services";

const orderedServices = [
  ...SERVICE_PLANS.filter((service) => service.featured),
  ...SERVICE_PLANS.filter((service) => !service.featured),
];

const offersSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: orderedServices.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Offer",
      name: `Pack ${service.title}`,
      description: service.description,
      price: String(service.price),
      priceCurrency: "CLP",
      itemOffered: {
        "@type": "Service",
        name: `Servicio de DJ ${service.title}`,
        description: service.description,
        provider: {
          "@type": "LocalBusiness",
          name: "DJ Pablito Dyr Producciones",
        },
        areaServed: {
          "@type": "City",
          name: "Santiago",
          addressCountry: "CL",
        },
      },
      availability: "https://schema.org/InStock",
      url: "https://djpablitodyr.cl/#services",
    },
  })),
};

const conditions = [
  {
    title: "Traslado",
    body: "Gratis dentro de Santiago. Sectores rurales +$20.000. Fuera de Santiago se cotiza por WhatsApp.",
  },
  {
    title: "Equipamiento",
    body: "Telón + proyector o pantalla según espacio y preferencia. Telón 80\" aprox. y pantalla 43\".",
  },
  {
    title: "Reserva",
    body: "Solo el 20% del total. El resto se paga una vez instalados los equipos en el evento.",
  },
  {
    title: "Beneficio incluido",
    body: "2 pantallas LED luminosas personalizadas con el nombre del festejado(a) en todos los packs.",
  },
  {
    title: "Forma de pago",
    body: "El servicio se paga una vez instalados los equipos. Los precios podrían variar en el tiempo.",
  },
];
---

<section id="services" aria-labelledby="services-title">
  <ServicesSection client:load />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(offersSchema)}
  />

  <div class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8">
    <div class="rounded-lg border border-zinc-800 bg-[#141416] p-5 md:p-7">
      <p
        class="text-[10px] font-black uppercase tracking-[0.18em] text-yellow-400"
      >
        Antes de reservar
      </p>
      <h3 class="mt-2 text-xl font-black text-white">Información importante</h3>
      <div class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {
          conditions.map((condition) => (
            <article class="rounded-sm border border-zinc-800 p-4">
              <h4 class="text-xs font-black uppercase tracking-wide text-yellow-300">
                {condition.title}
              </h4>
              <p class="mt-2 text-xs leading-relaxed text-zinc-400">
                {condition.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
