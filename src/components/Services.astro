// Structured Data for Service Offers
const featuredServices = services.filter((service) => service.featured);
const regularServices = services.filter((service) => !service.featured);
const visuallyOrderedServices = [...featuredServices, ...regularServices];

const offersSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": visuallyOrderedServices.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Offer",
      "name": `Pack ${service.title}`,
      "description": service.description,
      "price": service.price.replace(/[$.]/g, ''),
      "priceCurrency": "CLP",
      "itemOffered": {
        "@type": "Service",
        "name": `Servicio de DJ ${service.title}`,
        "description": service.description,
        "provider": {
          "@type": "LocalBusiness",
          "name": "DJ Pablito Dyr Producciones"
        },
        "areaServed": {
          "@type": "City",
          "name": "Santiago",
          "addressCountry": "CL"
        }
      },
      "availability": "https://schema.org/InStock",
      "url": "https://djpablitodyr.cl/#services"
    }
  }))
};
---

<section id="services" aria-labelledby="services-title">
  <h2
    id="services-title"
    class="text-center font-customFont text-3xl bg-zinc-800 py-10"
  >
    SERVICIOS
  </h2>
  <div class="flex flex-col gap-4 mx-3 mt-5">
    {
      featuredServices.map((service) => (
        <Service client:load key={service.title} service={service} />
      ))
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        regularServices.map((service) => (
          <Service client:load key={service.title} service={service} />
        ))
      }
    </div>
  </div>

  <!-- Service Offers Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(offersSchema)} />

  <div class="flex flex-col md:flex-row gap-5 px-5 pt-10">
    <div
      class="bg-white/5 text-white/90 flex flex-col mx-auto mt-5 w-4/5 md:w-1/2 h-1/2 p-4 rounded-2xl outline outline-1 outline-yellow-500/80 place-content-center"
    >
      <div class="px-10 text-pretty">
        <ul class="list-disc list-inside">
          <li class="my-2">
            <span class="font-bold text-yellow-500"> Consideraciones del servicio: </span>
            Traslado dentro de Santiago gratis. Sectores rurales +$20.000. Fuera de Santiago según cálculo previo.
          </li>
          <li class="my-2">
            <span class="font-bold text-yellow-500">
              Equipamiento y disponibilidad:
            </span>
            Telón + Proyector o Pantalla según espacio y preferencia del cliente. Telón 80" aproximadamente y Pantalla 43".
          </li>
          <li class="my-2">
            <span class="font-bold text-yellow-500">
              Políticas de reserva:
            </span>
            Reserva con solo el 20% del total del servicio. El resto se paga una vez instalados los equipos en el evento.
          </li>
          <li class="my-2">
            <span class="font-bold text-yellow-500">
              Gratis en todos los packs:
            </span>
            2 Pantallas Led Luminosas personalizadas con el nombre del festejado(a).
          </li>
        </ul>
      </div>
    </div>

    <div class="mx-auto w-4/5 md:w-1/4 mt-5">
      <div
        class="text-white/90 flex flex-col text-center rounded-2xl p-8 outline outline-1 outline-yellow-500/80"
      >
        <p>
          Costo de traslado de equipos
          <span class="font-bold text-yellow-500"
            >GRATIS dentro de Santiago.</span
          > Zonas rurales dentro de Santiago $20.000.
        </p>
        <p class="mt-2">
          El servicio se paga <span class="font-bold text-yellow-500">
            una vez instalados
          </span>
          los equipos en el evento.
        </p>
      </div>
      <p class="text-start text-sm my-4 text-white/80">
        * Los precios de los planes podrían variar en el tiempo
      </p>
    </div>
  </div>
</section>
