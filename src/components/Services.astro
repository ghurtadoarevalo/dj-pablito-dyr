// Structured Data for Service Offers
const featuredServices = services.filter((service) => service.featured);
const regularServices = services.filter((service) => !service.featured);
const visuallyOrderedServices = [...featuredServices, ...regularServices];

const offersSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": visuallyOrderedServices.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Offer",
      "name": `Pack ${service.title}`,
      "description": service.description,
      "price": service.price.replace(/[$.]/g, ''),
      "priceCurrency": "CLP",
      "itemOffered": {
        "@type": "Service",
        "name": `Servicio de DJ ${service.title}`,
        "description": service.description,
        "provider": {
          "@type": "LocalBusiness",
          "name": "DJ Pablito Dyr Producciones"
        },
        "areaServed": {
          "@type": "City",
          "name": "Santiago",
          "addressCountry": "CL"
        }
      },
      "availability": "https://schema.org/InStock",
      "url": "https://djpablitodyr.cl/#services"
    }
  }))
};
---

<section id="services" aria-labelledby="services-title">
  <h2
    id="services-title"
    class="text-center font-customFont text-3xl bg-zinc-800 py-10"
  >
    SERVICIOS
  </h2>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-5">
    <div class="flex flex-col gap-4">
      {
        featuredServices.map((service) => (
          <Service client:load key={service.title} service={service} />
        ))
      }

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          regularServices.map((service) => (
            <Service client:load key={service.title} service={service} />
          ))
        }
      </div>
    </div>
  </div>

  <!-- Service Offers Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(offersSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
    <div class="bg-zinc-800/60 rounded-3xl p-6 md:p-8 outline outline-1 outline-yellow-500/40">
      <h3 class="text-center text-xl md:text-2xl font-customFont text-white mb-6">
        Información importante
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="bg-white/5 rounded-xl p-5">
          <h4 class="font-bold text-yellow-500 mb-2">🚚 Traslado</h4>
          <p class="text-white/85 text-sm">
            Gratis dentro de Santiago. Sectores rurales +$20.000. Fuera de Santiago según cálculo previo.
          </p>
        </div>
        <div class="bg-white/5 rounded-xl p-5">
          <h4 class="font-bold text-yellow-500 mb-2">🖥️ Equipamiento</h4>
          <p class="text-white/85 text-sm">
            Telón + Proyector o Pantalla según espacio y preferencia. Telón 80" aprox. y Pantalla 43".
          </p>
        </div>
        <div class="bg-white/5 rounded-xl p-5">
          <h4 class="font-bold text-yellow-500 mb-2">📝 Reserva</h4>
          <p class="text-white/85 text-sm">
            Solo el 20% del total. El resto se paga una vez instalados los equipos en el evento.
          </p>
        </div>
        <div class="bg-white/5 rounded-xl p-5">
          <h4 class="font-bold text-yellow-500 mb-2">✨ Beneficio gratis</h4>
          <p class="text-white/85 text-sm">
            2 Pantallas Led Luminosas personalizadas con el nombre del festejado(a) en todos los packs.
          </p>
        </div>
        <div class="bg-white/5 rounded-xl p-5 md:col-span-2 lg:col-span-2">
          <h4 class="font-bold text-yellow-500 mb-2">💳 Forma de pago</h4>
          <p class="text-white/85 text-sm">
            El servicio se paga una vez instalados los equipos en el evento. Los precios de los planes podrían variar en el tiempo.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
