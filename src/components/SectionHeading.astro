---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
  id?: string;
}

const { kicker, title, lead, id } = Astro.props;
---

<div class="mb-8 md:mb-12">
  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-accent">
    {kicker}
  </p>
  <h2
    id={id}
    class="mt-2 break-words font-display text-3xl uppercase tracking-tight text-white md:text-4xl lg:text-5xl"
  >
    {title}
  </h2>
  {
    lead && (
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">{lead}</p>
    )
  }
</div>
