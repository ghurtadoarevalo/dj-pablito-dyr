---
interface Props {
  title: string;
  lead?: string;
  id?: string;
}

const { title, lead, id } = Astro.props;
---

<div class="mb-8 md:mb-12">
  <h2
    id={id}
    class="break-words font-display text-4xl uppercase leading-[0.9] tracking-tight text-paper sm:text-5xl lg:text-7xl"
  >
    {title}
  </h2>
  {
    lead && (
      <p class="mt-3 max-w-xl text-balance text-sm leading-relaxed text-muted">
        {lead}
      </p>
    )
  }
</div>
