---
import { Image } from "astro:assets";
import { SITE_TAGLINE } from "../data/site";
import logo from "../../public/logo.png";
import partyLoop from "@assets/hero/party-loop.mp4";
import partyPoster from "@assets/hero/party-poster.webp";
import boothLoop from "@assets/hero/booth-loop.mp4";
import boothPoster from "@assets/hero/booth-poster.webp";
import signLoop from "@assets/hero/sign-loop.mp4";
import signPoster from "@assets/hero/sign-poster.webp";
const [taglineLead, ...taglineRest] = SITE_TAGLINE.split(",");
const taglineTail = taglineRest.join(",").trim();
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="reveal relative isolate overflow-hidden bg-ink pt-12 pb-12 md:pt-20 md:pb-20"
>
  <div
    class="pointer-events-none absolute inset-0 bg-glow-hero"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_520px] lg:gap-14 lg:px-8"
  >
    <div class="max-w-4xl">
      <Image
        src={logo}
        alt=""
        aria-hidden="true"
        width={408}
        height={612}
        loading="eager"
        decoding="async"
        class="mb-6 h-24 w-auto object-contain lg:hidden"
      />
      <p
        class="flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.2em] text-accent-bright sm:text-xs"
      >
        <span class="h-px w-8 bg-accent-bright" aria-hidden="true"></span>
        DJ · Sonido · Iluminación · Santiago
      </p>
      <h1
        id="hero-title"
        class="mt-4 text-balance font-display text-[clamp(2.5rem,7vw,6rem)] uppercase leading-[0.88] tracking-tight text-paper"
      >
        {taglineLead}, {taglineTail}
      </h1>
      <p
        class="mt-6 max-w-2xl text-sm leading-relaxed text-paper/80 sm:text-base"
      >
        Ya hicimos cumpleaños, graduaciones, bodas de oro y hasta eventos
        municipales. Tú invitas, eliges la música y nosotros montamos todo:
        sonido, luces, karaoke y la mejor animación.
      </p>

      <div
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"
      >
        <a
          href="#services"
          class="flex min-h-12 items-center justify-center whitespace-nowrap rounded-control bg-accent px-6 py-3 text-sm font-black uppercase tracking-wide text-ink transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Ver packs y precios
        </a>
        <a
          href="https://wa.me/56971768418"
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-12 items-center justify-center whitespace-nowrap rounded-control border border-line px-6 py-3 text-sm font-bold text-paper transition-colors hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>

    <div
      class="mx-auto grid w-full max-w-sm grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] items-stretch gap-3 sm:max-w-md lg:mx-0 lg:max-w-none lg:justify-self-end"
    >
      <div
        class="hero-tile h-full overflow-hidden rounded-card border border-accent/30 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9)]"
      >
        <video
          data-hero-video
          class="h-full min-h-[240px] w-full object-cover"
          src={boothLoop}
          poster={boothPoster.src}
          preload="metadata"
          muted
          loop
          playsinline
          aria-label="DJ Pablito Dyr operando su controlador y laptop en un evento al aire libre"
        ></video>
      </div>
      <div class="grid gap-3">
        <div
          class="hero-tile hero-tile--2 overflow-hidden rounded-card border border-accent/30 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9)]"
        >
          <video
            data-hero-video
            class="aspect-[4/5] w-full object-cover"
            src={partyLoop}
            poster={partyPoster.src}
            preload="metadata"
            muted
            loop
            playsinline
            aria-label="Invitados bailando de noche con luces de colores en un evento"
          ></video>
        </div>
        <div
          class="hero-tile hero-tile--3 overflow-hidden rounded-card border border-accent/30 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9)]"
        >
          <video
            data-hero-video
            class="aspect-[4/5] w-full object-cover"
            src={signLoop}
            poster={signPoster.src}
            preload="metadata"
            muted
            loop
            playsinline
            aria-label="Cartel LED luminoso con el mensaje Feliz triple cumple junto al equipamiento de DJ"
          ></video>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-tile-rise {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* One authored arrival for the hero: the tiles land in reading order, so the
     section opens with movement instead of a static poster. */
  .hero-tile {
    animation: hero-tile-rise 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-tile--2 {
    animation-delay: 90ms;
  }

  .hero-tile--3 {
    animation-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tile {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const videos = document.querySelectorAll("[data-hero-video]");
    if (videos.length === 0) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const syncPlayback = () => {
      videos.forEach((node) => {
        if (!(node instanceof HTMLVideoElement)) return;
        if (reducedMotion.matches || document.hidden) {
          node.pause();
        } else {
          node.play().catch(() => {});
        }
      });
    };

    syncPlayback();
    reducedMotion.addEventListener("change", syncPlayback);
    document.addEventListener("visibilitychange", syncPlayback);
  })();
</script>
