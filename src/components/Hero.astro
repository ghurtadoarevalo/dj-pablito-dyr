---
import { Image } from "astro:assets";
import logo from "../../public/logo.png";
import djBackground from "@assets/djBackground.mp4";
---

<section id="home">
  <video
    class="absolute blur-md -z-10 pt-4"
    src={djBackground}
    width={2000}
    height={600}
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    poster="/logo.webp"
    aria-label="Video de fondo mostrando ambiente de fiesta con DJ"></video>
  <div
    class="flex flex-col md:flex-row md:place-content-evenly xl:h-screen place-items-center text-white/80"
  >
    <Image
      src={logo}
      alt="DJ Pablito Dyr - DJ Profesional en Santiago, Maipú y toda la Región Metropolitana"
      title="Logo DJ Pablito Dyr Producciones"
      loading="eager"
      fetchpriority="high"
      width={800}
      height={600}
      decoding="async"
      class="object-contain w-[70%] px-2 md:px-0 md:w-[60%] lg:w-[30%] animate-pulse"
    />
    <header
      class="bg-gray-800/80 text-center md:text-start rounded-xl w-screen md:w-1/2 xl:w-1/3 px-10 md:px-16 py-8 place-content-center"
    >
      <div class="text-b text-center">
        <h1 class="font-bold md:text-2xl">
          DJ Pablito Dyr - DJ Profesional en Santiago y Maipú | Animación y
          Karaoke
        </h1>
        <p class="font-light text-lg mt-2">
          De Santiago de Chile 🇨🇱 para el mundo
        </p>
        <hr class="mt-6 border-yellow-500" />
        <p class="mt-5 font-thin text-xl">
          Tú preocúpate de vivir el mejor momento junto a tus invitados,
          ¡nosotros les entregamos todo lo demás!
        </p>
        <p class="mt-3 font-thin text-lg text-white/70">
          Servicio profesional de DJ, sonido, iluminación LED y animación para
          matrimonios, cumpleaños, graduaciones y eventos corporativos en toda
          la zona metropolitana.
        </p>
      </div>
      <nav>
        <a href="#services">
          <button
            aria-label="Ver sección de servicios de DJ Pablito Dyr"
            class="mt-5 hover:bg-white/30 text-xl rounded-lg w-full p-2 outline outline-1 outline-yellow-500 font-customFont"
            >Nuestros servicios</button
          ></a
        >
      </nav>
    </header>
  </div>
</section>
