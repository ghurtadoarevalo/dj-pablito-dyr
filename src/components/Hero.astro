---
import { Image } from "astro:assets";
import logo from "../../public/logo.png";
import djBackground from "@assets/djBackground.mp4";
import { TESTIMONIALS } from "../data/testimonials";

const featured = TESTIMONIALS.find((testimonial) => testimonial.highlighted);
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="reveal relative isolate flex min-h-[calc(100svh-4rem)] overflow-hidden bg-ink"
>
  <div
    class="pointer-events-none absolute inset-0 bg-glow-hero"
    aria-hidden="true"
  >
  </div>

  <Image
    src={logo}
    alt=""
    aria-hidden="true"
    width={800}
    height={600}
    loading="eager"
    decoding="async"
    class="pointer-events-none absolute -right-24 top-10 w-80 opacity-10 blur-2xl md:hidden"
  />

  <div
    class="pointer-events-none absolute inset-0 hidden md:block"
    aria-hidden="true"
  >
    <video
      data-hero-video
      class="h-full w-full object-cover opacity-25 blur-[2px]"
      src={djBackground}
      poster="/logo.webp"
      preload="none"
      muted
      loop
      playsinline
      aria-label="Video de fondo mostrando ambiente de fiesta con DJ"></video>
    <div
      class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-transparent"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <Image
        src={logo}
        alt=""
        aria-hidden="true"
        width={800}
        height={600}
        loading="eager"
        decoding="async"
        class="mb-6 h-12 w-auto object-contain md:h-14"
      />
      <p
        class="text-[10px] font-black uppercase tracking-[0.2em] text-accent sm:text-xs"
      >
        DJ · Sonido · Iluminación · Santiago
      </p>
      <h1
        id="hero-title"
        class="mt-4 font-display text-[clamp(2.5rem,8vw,5.5rem)] uppercase leading-[0.92] tracking-tight text-white"
      >
        ¡Que tu fiesta se sienta <span class="text-accent">enorme!</span>
      </h1>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
        Elige un pack probado o arma tu evento a medida. Precios claros,
        producción completa y coordinación directa por WhatsApp.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#services"
          class="flex min-h-12 items-center justify-center rounded-control bg-accent px-6 py-3 text-sm font-black uppercase tracking-wide text-ink transition-colors hover:bg-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Ver packs y precios
        </a>
        <a
          href="https://wa.me/56971768418"
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-12 items-center justify-center rounded-control border border-line-strong px-6 py-3 text-sm font-bold text-white transition-colors hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Escríbenos por WhatsApp
        </a>
      </div>

      {
        featured && (
          <figure class="mt-10 max-w-2xl rounded-card border border-line border-l-2 border-l-accent bg-surface p-5">
            <blockquote class="text-sm leading-relaxed text-white md:text-base">
              “{featured.quote}”
            </blockquote>
            <figcaption class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] font-bold uppercase tracking-wide">
              <span class="text-accent">{featured.handle}</span>
              <span class="text-muted">· {featured.context}</span>
              <a
                href="#testimonios"
                class="text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-white"
              >
                Ver las 5 reseñas
              </a>
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const video = document.querySelector("[data-hero-video]");
    if (!(video instanceof HTMLVideoElement)) return;

    const desktop = window.matchMedia("(min-width: 768px)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const syncPlayback = () => {
      if (desktop.matches && !reducedMotion.matches) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };

    syncPlayback();
    desktop.addEventListener("change", syncPlayback);
    reducedMotion.addEventListener("change", syncPlayback);
  })();
</script>
