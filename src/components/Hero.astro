---
import { Image } from "astro:assets";
import logo from "../../public/logo.png";
import djBackground from "@assets/djBackground.mp4";
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="relative isolate flex min-h-[calc(100svh-4rem)] overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(246,201,69,0.14),transparent_34%),radial-gradient(circle_at_10%_80%,rgba(246,201,69,0.06),transparent_30%)]"
    aria-hidden="true"
  >
  </div>

  <Image
    src={logo}
    alt=""
    aria-hidden="true"
    width={800}
    height={600}
    loading="eager"
    decoding="async"
    class="pointer-events-none absolute -right-24 top-10 w-80 opacity-10 blur-2xl md:hidden"
  />

  <div
    class="pointer-events-none absolute inset-0 hidden md:block"
    aria-hidden="true"
  >
    <video
      data-hero-video
      class="h-full w-full object-cover opacity-25 blur-[2px]"
      src={djBackground}
      poster="/logo.webp"
      preload="none"
      muted
      loop
      playsinline
      aria-label="Video de fondo mostrando ambiente de fiesta con DJ"></video>
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#0b0b0d] via-[#0b0b0d]/80 to-transparent"
    >
    </div>
  </div>

  <div
    class="relative mx-auto grid w-full max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_380px] lg:px-8"
  >
    <div class="max-w-3xl">
      <p
        class="text-[10px] font-black uppercase tracking-[0.2em] text-yellow-400 sm:text-xs"
      >
        DJ · Sonido · Iluminación · Santiago
      </p>
      <h1
        id="hero-title"
        class="mt-4 font-display text-5xl uppercase leading-[0.92] tracking-tight text-white sm:text-7xl lg:text-8xl"
      >
        ¡Que tu fiesta se sienta <span class="text-yellow-400">enorme!</span>
      </h1>
      <p
        class="mt-6 max-w-2xl text-sm leading-relaxed text-zinc-300 sm:text-base"
      >
        Elige un pack probado o arma tu evento a medida. Precios claros,
        producción completa y coordinación directa por WhatsApp.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#services"
          class="flex min-h-12 items-center justify-center rounded-sm bg-yellow-400 px-6 py-3 text-sm font-black uppercase tracking-wide text-zinc-950 transition-colors hover:bg-yellow-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
        >
          Ver packs y precios
        </a>
        <a
          href="#contact"
          class="flex min-h-12 items-center justify-center rounded-sm border border-zinc-700 px-6 py-3 text-sm font-bold text-white transition-colors hover:border-yellow-400 hover:text-yellow-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
        >
          Hablar por WhatsApp
        </a>
      </div>

      <ul
        class="mt-10 flex flex-wrap gap-x-8 gap-y-4 border-t border-zinc-800 pt-6"
        aria-label="Datos rápidos del servicio"
      >
        <li>
          <strong class="block text-xl font-black text-white">5</strong>
          <span class="text-[10px] uppercase tracking-wide text-zinc-500">
            packs base
          </span>
        </li>
        <li>
          <strong class="block text-xl font-black text-white">20%</strong>
          <span class="text-[10px] uppercase tracking-wide text-zinc-500">
            para reservar
          </span>
        </li>
        <li>
          <strong class="block text-xl font-black text-white">$0</strong>
          <span class="text-[10px] uppercase tracking-wide text-zinc-500">
            traslado en Santiago
          </span>
        </li>
      </ul>
    </div>

    <div class="relative hidden justify-center lg:flex">
      <div
        class="absolute inset-8 rounded-full bg-yellow-400/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <Image
        src={logo}
        alt="DJ Pablito Dyr, DJ profesional en Santiago"
        title="DJ Pablito Dyr Producciones"
        loading="eager"
        fetchpriority="high"
        width={800}
        height={600}
        decoding="async"
        class="relative w-full max-w-sm object-contain"
      />
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const video = document.querySelector("[data-hero-video]");
    if (!(video instanceof HTMLVideoElement)) return;

    const desktop = window.matchMedia("(min-width: 768px)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const syncPlayback = () => {
      if (desktop.matches && !reducedMotion.matches) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };

    syncPlayback();
    desktop.addEventListener("change", syncPlayback);
    reducedMotion.addEventListener("change", syncPlayback);
  })();
</script>
