---
import { SITE_TAGLINE } from "../data/site";
---

<section
  aria-label="Reserva tu evento"
  class="border-y border-accent/30 bg-accent py-14 text-ink md:py-20"
>
  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 px-4 sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:px-8"
  >
    <div class="max-w-3xl">
      <p class="text-[10px] font-black uppercase tracking-[0.22em] text-ink/70">
        Agenda abierta · Santiago y alrededores
      </p>
      <p
        class="mt-3 font-display text-4xl uppercase leading-[0.9] tracking-tight text-ink sm:text-5xl lg:text-7xl"
      >
        {SITE_TAGLINE}
      </p>
      <p class="mt-4 max-w-xl text-sm font-semibold text-ink/80 md:text-base">
        5 packs base, cotización exacta en el configurador y 20% para reservar.
        Coordinás todo directo por WhatsApp.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
      <a
        href="https://wa.me/56971768418"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-12 items-center justify-center rounded-control bg-ink px-7 text-sm font-black uppercase tracking-wide text-accent transition-colors duration-snap hover:bg-ink/85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        Escríbenos por WhatsApp
      </a>
      <a
        href="#services"
        class="inline-flex min-h-12 items-center justify-center rounded-control border-2 border-ink/40 px-7 text-sm font-black uppercase tracking-wide text-ink transition-colors duration-snap hover:border-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        Ver packs y precios
      </a>
    </div>
  </div>
</section>
