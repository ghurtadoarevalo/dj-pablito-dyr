---
import { Image } from "astro:assets";
import ddj400 from "@assets/equipments/ddj400.png";
import beam30 from "@assets/equipments/beam30.png";
import ledLight from "@assets/equipments/ledLight.png";
import jbl115 from "@assets/equipments/jbl115.png";
import tvsamsung from "@assets/equipments/tvsamsung.png";
import fogmachine from "@assets/equipments/fogmachine.png";
import mics from "@assets/equipments/mics.png";
import arcoatril from "@assets/equipments/arcoatril.webp";
import ledspider from "@assets/equipments/ledspider.png";
import lightBoard from "@assets/equipments/lightBoard.png";
import projector from "@assets/equipments/projector.png";

interface Props {
  name: string;
  description: string;
  imgName: string;
  quantity: number;
  label: string;
  size?: "hero" | "wide" | "tall" | "base";
}

interface Dictionary<T> {
  [Key: string]: T;
}

const imgs: Dictionary<ImageMetadata> = {
  ddj400,
  beam30,
  ledLight,
  jbl115,
  tvsamsung,
  fogmachine,
  mics,
  arcoatril,
  ledspider,
  lightBoard,
  projector,
};

const {
  name,
  description,
  imgName,
  quantity,
  label,
  size = "base",
} = Astro.props;

const spans: Record<string, string> = {
  hero: "col-span-2 row-span-2",
  wide: "col-span-2 row-span-1",
  tall: "col-span-1 row-span-2",
  base: "col-span-1 row-span-1",
};

const imageScale: Record<string, string> = {
  hero: "left-1/2 top-[42%] h-[62%] w-[72%]",
  wide: "left-[76%] top-[34%] h-[48%] w-[30%]",
  tall: "left-1/2 top-[44%] h-[74%] w-[80%]",
  base: "left-1/2 top-[38%] h-[50%] w-[74%]",
};

const isLarge = size === "hero";
---

<article
  class={`equipment-card group relative flex flex-col justify-end overflow-hidden rounded-card border border-line bg-gradient-to-b from-surface to-ink p-4 transition duration-snap hover:border-line-strong md:p-5 ${spans[size]}`}
>
  <Image
    src={imgs[imgName]}
    alt={label}
    title={name}
    width={872}
    height={497}
    loading="lazy"
    class={`pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 object-contain drop-shadow-[0_18px_28px_rgba(0,0,0,0.55)] transition duration-reveal ease-reveal group-hover:scale-[1.04] ${imageScale[size]}`}
  />

  <p
    class="absolute right-4 top-4 rounded-control border border-accent/40 bg-ink/70 px-2 py-1 text-[10px] font-black text-accent"
  >
    ×{quantity}
  </p>

  <div class="relative">
    <h3
      class={`font-display uppercase leading-none tracking-tight text-white ${isLarge ? "text-2xl md:text-3xl" : size === "wide" ? "text-xl" : "text-lg"}`}
    >
      {name}
    </h3>
    {
      (
        <p
          class={`mt-1 text-muted ${isLarge ? "max-w-sm text-sm leading-relaxed line-clamp-3" : size === "base" ? "text-[11px] leading-snug line-clamp-1" : "text-xs leading-snug line-clamp-2"}`}
        >
          {description}
        </p>
      )
    }
  </div>
</article>
