---
import { Image } from "astro:assets";
import ddj400 from "@assets/equipments/ddj400.png";
import beam30 from "@assets/equipments/beam30.png";
import ledLight from "@assets/equipments/ledLight.png";
import jbl115 from "@assets/equipments/jbl115.png";
import tvsamsung from "@assets/equipments/tvsamsung.png";
import fogmachine from "@assets/equipments/fogmachine.png";
import mics from "@assets/equipments/mics.png";
import arcoatril from "@assets/equipments/arcoatril.webp";
import ledspider from "@assets/equipments/ledspider.png";
import lightBoard from "@assets/equipments/lightBoard.png";
import projector from "@assets/equipments/projector.png";

interface Props {
  name: string;
  description: string;
  imgName: string;
  quantity: number;
  label: string;
  size?: "hero" | "wide" | "tall" | "base";
}

interface Dictionary<T> {
  [Key: string]: T;
}

const imgs: Dictionary<ImageMetadata> = {
  ddj400,
  beam30,
  ledLight,
  jbl115,
  tvsamsung,
  fogmachine,
  mics,
  arcoatril,
  ledspider,
  lightBoard,
  projector,
};

const {
  name,
  description,
  imgName,
  quantity,
  label,
  size = "base",
} = Astro.props;

const spans: Record<string, string> = {
  hero: "col-span-2 row-span-2",
  wide: "col-span-2 row-span-1",
  tall: "col-span-1 row-span-2",
  base: "col-span-1 row-span-1",
};

const imageScale: Record<string, string> = {
  hero: "left-1/2 top-[42%] h-[62%] w-[72%]",
  tall: "left-1/2 top-[44%] h-[74%] w-[80%]",
  base: "left-1/2 top-[42%] h-[58%] w-[78%]",
};

const isLarge = size === "hero";
const isWide = size === "wide";
---

<article
  class={`equipment-card group relative flex overflow-hidden rounded-card border border-line bg-gradient-to-b from-surface to-ink p-4 transition duration-snap hover:border-line-strong md:p-5 ${spans[size]} ${
    isWide ? "flex-row items-center gap-4 md:gap-6" : "flex-col justify-end"
  }`}
>
  {
    isWide ? (
      <>
        <div class="min-w-0 flex-1">
          <h3 class="font-display text-xl uppercase leading-none tracking-tight text-white">
            {name}
          </h3>
          <p class="mt-2 text-xs leading-snug text-muted line-clamp-2">
            {description}
          </p>
        </div>
        <Image
          src={imgs[imgName]}
          alt={label}
          title={name}
          width={872}
          height={497}
          loading="lazy"
          class="h-[76%] w-[42%] shrink-0 object-contain drop-shadow-[0_18px_28px_rgba(0,0,0,0.55)] transition duration-reveal ease-reveal group-hover:scale-[1.04]"
        />
      </>
    ) : (
      <>
        <Image
          src={imgs[imgName]}
          alt={label}
          title={name}
          width={872}
          height={497}
          loading="lazy"
          class={`pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 object-contain drop-shadow-[0_18px_28px_rgba(0,0,0,0.55)] transition duration-reveal ease-reveal group-hover:scale-[1.04] ${imageScale[size]}`}
        />
        <p class="absolute right-4 top-4 rounded-control border border-accent/40 bg-ink/70 px-2 py-1 text-[10px] font-black text-accent">
          ×{quantity}
        </p>
        <div class="relative">
          <h3
            class={`font-display uppercase leading-none tracking-tight text-white ${
              isLarge ? "text-2xl md:text-3xl" : "text-lg"
            }`}
          >
            {name}
          </h3>
          {isLarge && (
            <p class="mt-1 max-w-sm text-sm leading-relaxed text-muted line-clamp-3">
              {description}
            </p>
          )}
        </div>
      </>
    )
  }
</article>
