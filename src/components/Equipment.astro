---
import { Image } from "astro:assets";
import ddj400 from "@assets/equipments/ddj400.png";
import beam30 from "@assets/equipments/beam30.png";
import ledLight from "@assets/equipments/ledLight.png";
import jbl115 from "@assets/equipments/jbl115.png";
import tvsamsung from "@assets/equipments/tvsamsung.png";
import fogmachine from "@assets/equipments/fogmachine.png";
import mics from "@assets/equipments/mics.png";
import arcoatril from "@assets/equipments/arcoatril.webp";
import ledspider from "@assets/equipments/ledspider.png";
import lightBoard from "@assets/equipments/lightBoard.png";
import projector from "@assets/equipments/projector.png";

interface Props {
  name: string;
  description: string;
  imgName: string;
  quantity: number;
  label: string;
  featured?: boolean;
}

interface Dictionary<T> {
  [Key: string]: T;
}

const imgs: Dictionary<ImageMetadata> = {
  ddj400,
  beam30,
  ledLight,
  jbl115,
  tvsamsung,
  fogmachine,
  mics,
  arcoatril,
  ledspider,
  lightBoard,
  projector,
};

const {
  name,
  description,
  imgName,
  quantity,
  label,
  featured = false,
} = Astro.props;
---

<article
  class={`equipment-card rounded-card border border-line bg-surface px-6 py-8 ${
    featured
      ? "flex flex-col items-center gap-6 text-center sm:col-span-2 sm:flex-row sm:text-left"
      : "flex flex-col items-center text-center"
  }`}
>
  <Image
    src={imgs[imgName]}
    alt={label}
    title={name}
    width={160}
    height={110}
    class={`h-auto object-contain ${featured ? "w-44 sm:w-52" : "mb-6 w-36"}`}
    loading="lazy"
  />
  <div>
    <p class="mb-2 text-sm font-medium text-accent">×{quantity}</p>
    <h3 class="mb-3 text-base font-bold uppercase tracking-wider text-white">
      {name}
    </h3>
    <p
      class={`text-sm leading-relaxed text-muted ${featured ? "" : "max-w-xs"}`}
    >
      {description}
    </p>
  </div>
</article>
