---
const faqs = [
  {
    question: "¿En qué zonas de Santiago prestan servicio?",
    answer:
      "Prestamos servicio en toda la Región Metropolitana de Santiago, especialmente en Maipú y la zona oeste. El traslado es GRATIS dentro de Santiago. Para zonas rurales dentro de Santiago, el costo de traslado es de $20.000. Fuera de Santiago el valor se calcula previamente.",
  },
  {
    question: "¿Cuánto cuesta el servicio de DJ?",
    answer:
      "Nuestros servicios van desde $150.000 (Pack Celebration) hasta $400.000 (Pack Premium Infinity). Cada pack incluye diferentes horas de música, equipos de iluminación y servicios adicionales como animación y karaoke. Contáctanos para cotizar el pack perfecto para tu evento.",
  },
  {
    question: "¿Cuál es la diferencia entre los packs?",
    answer:
      "Los packs varían en duración (4 a 8 horas), cantidad de equipos de iluminación, inclusión de servicios como animación profesional, karaoke, micrófonos inalámbricos, pantalla, proyector y telón. Los packs Karaoke Dancing, Gold Karaoke y Premium Infinity incluyen videos musicales y karaoke en vivo.",
  },
  {
    question: "¿Los packs incluyen animación y karaoke?",
    answer:
      "Los packs Full Dancing, Karaoke Dancing, Gold Karaoke y Premium Infinity incluyen DJ y animación. El karaoke y videos musicales están incluidos en los packs Karaoke Dancing, Gold Karaoke y Premium Infinity.",
  },
  {
    question: "¿Cómo se realiza el pago del servicio?",
    answer:
      "La reserva se realiza con el 20% del total del servicio. El resto del pago se realiza una vez que llegamos a hacer la instalación de los equipos en el evento.",
  },
  {
    question: "¿Qué tipo de eventos cubren?",
    answer:
      "Realizamos todo tipo de eventos: matrimonios, cumpleaños, graduaciones, bautizos, eventos corporativos, fiestas privadas y más. Contamos con más de 4 años de experiencia en Maipú y toda la Región Metropolitana.",
  },
  {
    question: "¿Qué incluye el servicio de iluminación?",
    answer:
      "Según el pack, incluimos luces LED Spider RGB, luces LED RGB 18, luces Beam 360°, luces láser RGB, atriles o arco de iluminación, máquina de humo y 2 Pantallas Led Luminosas personalizadas con el nombre del festejado(a) gratis en todos los packs.",
  },
  {
    question: "¿Cuánto cuesta una hora extra de servicio?",
    answer:
      "El costo de hora extra varía según el pack: $25.000 para Pack Celebration; $30.000 para Pack Full Dancing; $35.000 para Pack Karaoke Dancing y Pack Gold Karaoke; y $40.000 para Pack Premium Infinity.",
  },
];

// FAQ Schema (JSON-LD)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
import SectionHeading from "./SectionHeading.astro";
---

<section
  id="faq"
  aria-labelledby="faq-title"
  class="reveal border-t border-line bg-ink py-16 md:py-20"
>
  <div
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:grid lg:grid-cols-[minmax(0,340px)_1fr] lg:gap-14 lg:px-8"
  >
    <div class="lg:sticky lg:top-24 lg:self-start">
      <SectionHeading
        id="faq-title"
        kicker="Antes de reservar"
        title="Preguntas frecuentes"
        lead="Lo que más nos preguntan antes de reservar."
      />
    </div>

    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="group rounded-card border border-line bg-surface">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 p-5 text-sm font-bold text-white">
              {faq.question}
              <span
                class="text-accent transition-transform duration-snap group-open:rotate-180"
                aria-hidden="true"
              >
                ▾
              </span>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-muted text-pretty">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>

  <!-- FAQ Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
