---
import Equipment from "./Equipment.astro";
import SectionHeading from "./SectionHeading.astro";

const equipements = [
  {
    name: "Pioneer DDJ-400",
    description:
      "Controlador DJ de 2 canales para rekordbox. Todo el poder de la mezcla en un solo lugar.",
    imgName: "ddj400",
    quantity: 1,
    label:
      "Controlador Pioneer DDJ-400 - Equipo profesional de DJ usado por DJ Pablito Dyr",
  },
  {
    name: "Spot 30W",
    description:
      "Cabezal móvil LED de 30 watts. Ideal para iluminar la pista con un toque profesional.",
    imgName: "beam30",
    quantity: 2,
    label:
      "Cabezal móvil LED SPOT 30W - Iluminación profesional para eventos y fiestas",
  },
  {
    name: "Luz LED RGB",
    description: "Luz de escenario LED RGB de 18 luces con control DMX.",
    imgName: "ledLight",
    quantity: 10,
    label:
      "Luz LED RGB de escenario - Iluminación profesional con control DMX para eventos",
  },
  {
    name: "JBL JRX 115",
    description:
      "Sistema de altavoces de refuerzo de sonido bidireccional. Más de 1000W de potencia con el mejor sonido.",
    imgName: "jbl115",
    quantity: 2,
    label:
      "Parlantes JBL JRX 115 - Sistema de sonido profesional de 1000W para eventos",
  },
  {
    name: `Pantalla de 43"`,
    description:
      'Pantalla de 43" para karaoke y videos, ubicada según el espacio y la preferencia del cliente.',
    imgName: "tvsamsung",
    quantity: 1,
    label: "Pantalla de 43 pulgadas para karaoke y videos en eventos",
  },
  {
    name: "Máquina de humo",
    description:
      "Máquina de humo de 1200 a 1500 Watts. Lleva tu fiesta a otro nivel.",
    imgName: "fogmachine",
    quantity: 1,
    label:
      "Máquina de humo profesional 1500W - Efectos especiales para fiestas y eventos",
  },
  {
    name: "Micrófono inalámbrico",
    description:
      "Micrófono inalámbrico de alta calidad, para que no haya excusas para cantar o animar tus fiestas.",
    imgName: "mics",
    quantity: 2,
    label:
      "Micrófonos inalámbricos profesionales - Equipo de audio para karaoke y animación",
  },
  {
    name: "Spider Beam RGB",
    description: "Cabezas móviles RGB para iluminar todo al ritmo de la música.",
    imgName: "ledspider",
    quantity: 2,
    label:
      "Spider Beam RGB - Cabezales móviles de iluminación LED para eventos y fiestas",
  },
  {
    name: "Atril de iluminación Carverpro",
    description:
      "Atril de iluminación doble. Ajustable de 1,8 m a 3,45 m de altura y 3,6 m de ancho. Para todos aquellos que quieran una pista o escenario con un toque profesional.",
    imgName: "arcoatril",
    quantity: 2,
    label:
      "Atril de iluminación Carverpro - Sistema profesional de montaje de luces para eventos",
  },
  {
    name: "Pizarra LED luminosa",
    description:
      "Pizarra LED luminosa donde se puede escribir el nombre de los festejados o el mensaje que quieras.",
    imgName: "lightBoard",
    quantity: 2,
    label: "Pizarra Led luminosa - Pizarra profesional para eventos y fiestas",
  },
  {
    name: "Proyector y telón",
    description:
      'Proyector de alta resolución con telón de 80" aproximadamente, montado según el espacio.',
    imgName: "projector",
    quantity: 1,
    label:
      "Proyector y telón de gran formato - Equipo audiovisual profesional para videos, presentaciones y karaoke en eventos",
  },
];
const SIZES: Record<number, "hero" | "wide" | "tall"> = {
  0: "hero", // Pionner DDJ-400
  1: "wide", // Spot 30W
  2: "tall", // Luz LED RGB
  4: "hero", // Pantalla / Proyector + Telón
  6: "wide", // Micrófonos
  10: "tall", // Proyector y telón
};
---

<section
  id="equipment"
  aria-labelledby="equipment-title"
  class="reveal border-t border-line bg-ink py-12 md:py-20"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="equipment-title"
      kicker="Sonido e iluminación"
      title="Equipamiento"
      lead="Sonido, iluminación y tecnología profesional para tu evento"
    />

    <div
      class="equipment-grid grid grid-cols-2 auto-rows-[168px] gap-3 md:grid-cols-4 md:auto-rows-[190px] md:gap-4"
    >
      {
        equipements.map((equipment, index) => (
          <Equipment
            name={equipment.name}
            description={equipment.description}
            imgName={equipment.imgName}
            quantity={equipment.quantity}
            label={equipment.label}
            size={SIZES[index] ?? "base"}
          />
        ))
      }
    </div>
  </div>

  <noscript>
    <style>
      .equipment-card {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
      }
    </style>
  </noscript>
</section>

<style>
  @keyframes equipment-in {
    from {
      opacity: 0.45;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(.equipment-card) {
        animation: equipment-in linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 26%;
      }
    }
  }
</style>
