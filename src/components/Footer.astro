---
import { Image } from "astro:assets";

const year = new Date().getFullYear();
---

<footer
  class="flex flex-col items-center justify-between gap-4 border-t border-line bg-surface px-4 py-8 text-sm text-paper/70 md:flex-row md:px-8"
>
  <p class="text-center text-xs text-paper/60 md:text-left">
    © {year} DJ Pablito Dyr. Todos los derechos reservados.
  </p>

  <div
    class="flex min-h-11 flex-row items-center gap-3 rounded-pill bg-surface-raised pr-5 transition-colors hover:text-paper/70"
  >
    <Image
      src="https://unavatar.io/github/ghurtadoarevalo"
      alt="Avatar del desarrollador web ghurtado_dev quien desarrolló la página de DJ Pablito Dyr"
      title="Desarrollador Web gHurtado_dev"
      width={30}
      height={20}
      class="rounded-l-full"
      loading="lazy"
    />
    <div>
      <a
        href="https://portfolio.ghurtadodev.cl/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center justify-center text-center"
        aria-label="Link a página web del desarrollador ghurtado_dev, quien creó la página dj pablito dyr"
      >
        <p>Desarrollado por gHurtado_dev</p>
      </a>
    </div>
  </div>
</footer>
