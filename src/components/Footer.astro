---
import { Image } from "astro:assets";
import { SITE_TAGLINE } from "../data/site";

const year = new Date().getFullYear();
---

<footer
  class="flex flex-col gap-3 border-t border-line bg-surface px-4 pt-10 pb-5 text-sm text-white/80 flex flex-col md:flex-row gap-3 place-items-center place-content-center"
>
  <p
    class="text-center text-[10px] font-black uppercase tracking-[0.16em] text-accent"
  >
    {SITE_TAGLINE}
  </p>

  <div class="text-center italic">
    <p class="w-2/3 mx-auto">
      © {year} Dj Pablito Dyr. Todos los derechos reservados.
    </p>
  </div>

  <div
    class="flex min-h-11 flex-row place-items-center gap-3 bg-surface-raised hover:outline hover:outline-1 hover:outline-white/70 hover:text-white/70 text-white/50 rounded-full pr-5"
  >
    <Image
      src="https://unavatar.io/github/ghurtadoarevalo"
      alt="Avatar del desarrollador web ghurtado_dev quien desarrolló la página de DJ Pablito Dyr"
      title="Desarrollador Web gHurtado_dev"
      width={30}
      height={20}
      class="rounded-l-full"
      loading="lazy"
    />
    <div>
      <a
        href="https://portfolio.ghurtadodev.cl/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-center"
        aria-label="Link a página web del desarrollador ghurtado_dev, quien creó la página dj pablito dyr"
      >
        <p>Desarrollado por gHurtado_dev</p>
      </a>
    </div>
  </div>
</footer>
