---
export interface Props {
  title: string;
  videoCode: string;
}

const { title, videoCode } = Astro.props;
---

<a
  href={`https://www.youtube.com/watch?v=${videoCode}`}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative block aspect-video w-full overflow-hidden rounded-card border border-line transition duration-snap hover:-translate-y-0.5 hover:border-line-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  style={`background-image:url(https://img.youtube.com/vi/${videoCode}/sddefault.jpg); background-position: center; background-size: cover`}
>
  <span
    class="absolute inset-0 block bg-ink/60 transition-colors duration-snap group-hover:bg-ink/40"
    aria-hidden="true"></span>
  <span
    class="absolute inset-x-0 bottom-0 block bg-gradient-to-t from-ink via-ink/60 to-transparent px-5 pb-4 pt-16 font-display text-2xl uppercase leading-none tracking-tight text-paper sm:text-3xl"
    aria-hidden="true">{title}</span
  >
  <span
    class="absolute left-1/2 top-1/2 flex size-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center"
    aria-hidden="true"
  >
    <svg height="100%" version="1.1" viewBox="0 0 68 48" width="100%">
      <path
        d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"
        fill="rgba(234,179,8,0.9)"></path>
      <path d="M 45,24 27,14 27,34" fill="#fff"></path>
    </svg>
  </span>
  <span class="sr-only">Ver {title} en YouTube</span>
</a>
