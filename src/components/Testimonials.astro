---
import SectionHeading from "./SectionHeading.astro";
import { INSTAGRAM_PROFILE_URL, TESTIMONIALS } from "../data/testimonials";

const TRACK_ID = "testimonials-track";
const SLIDES = [...TESTIMONIALS, ...TESTIMONIALS];
const TOTAL = TESTIMONIALS.length;
---

<section
  id="testimonios"
  aria-labelledby="testimonials-title"
  class="reveal border-t border-line bg-ink pt-6 pb-16 md:pt-8 md:pb-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        id="testimonials-title"
        kicker="Clientes reales"
        title="Testimonios"
        lead="Comentarios públicos que dejaron en nuestro Instagram, sin editar."
      />
      <div class="mb-8 flex gap-2 md:mb-12">
        <button
          type="button"
          data-carousel="prev"
          data-target={TRACK_ID}
          aria-label="Testimonio anterior"
          aria-controls={TRACK_ID}
          class="grid size-11 place-items-center rounded-control border border-line-strong text-white transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          data-carousel="next"
          data-target={TRACK_ID}
          aria-label="Testimonio siguiente"
          aria-controls={TRACK_ID}
          class="grid size-11 place-items-center rounded-control border border-line-strong text-white transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true">→</span>
        </button>
        <button
          type="button"
          data-carousel="toggle"
          data-target={TRACK_ID}
          aria-label="Pausar el carrusel de testimonios"
          aria-controls={TRACK_ID}
          class="grid size-11 place-items-center rounded-control border border-line-strong text-white transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true" data-carousel-icon>❚❚</span>
        </button>
      </div>
    </div>

    <ul
      id={TRACK_ID}
      role="region"
      aria-label="Testimonios de clientes"
      tabindex="0"
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      {
        SLIDES.map((testimonial, index) => (
          <li
            aria-hidden={index >= TOTAL ? "true" : undefined}
            class={`relative flex shrink-0 snap-start basis-[85%] flex-col justify-between rounded-card border border-line bg-surface p-5 sm:basis-[48%] lg:basis-[32%] ${
              testimonial.highlighted ? "border-l-2 border-l-accent" : ""
            }`}
          >
            <blockquote class="text-sm leading-relaxed text-white">
              “{testimonial.quote}”
            </blockquote>
            <p class="mt-4 text-[10px] font-bold uppercase tracking-wide">
              <span class="text-accent">{testimonial.handle}</span>
              <span class="text-muted"> · {testimonial.context}</span>
              {index < TOTAL && (
                <span class="sr-only">
                  {" "}
                  (testimonio {index + 1} de {TOTAL})
                </span>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <a
        href={INSTAGRAM_PROFILE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-control border border-line-strong px-5 text-sm font-bold text-white transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Ver más reseñas en Instagram
      </a>
      <p class="text-[10px] font-bold uppercase tracking-wide text-muted">
        Desliza, usa las flechas o pausa el movimiento
      </p>
    </div>
  </div>
</section>

<script>
  const AUTOPLAY_MS = 5200;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function setupCarousel() {
    const track = document.getElementById("testimonials-track");
    if (!track) return;

    const slides = [...track.querySelectorAll("li")];
    const half = slides.length / 2;
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-carousel="toggle"]',
    );
    const icon = toggle?.querySelector<HTMLElement>("[data-carousel-icon]");
    let timer: number | null = null;
    let paused = reduceMotion.matches;

    const stepSize = () => {
      const card = slides[0];
      const gap = parseFloat(getComputedStyle(track).columnGap || "0");
      return card ? card.getBoundingClientRect().width + gap : 0;
    };

    const normalize = () => {
      const loopWidth = stepSize() * half;
      if (!loopWidth) return;
      if (track.scrollLeft >= loopWidth - 2) {
        track.scrollLeft -= loopWidth;
      } else if (track.scrollLeft < 2) {
        track.scrollLeft += loopWidth;
      }
    };

    const move = (direction: number, smooth: boolean) => {
      track.scrollBy({
        left: direction * stepSize(),
        behavior: smooth ? "smooth" : "auto",
      });
      window.setTimeout(normalize, smooth ? 700 : 60);
    };

    const stop = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const syncToggle = () => {
      if (!toggle || !icon) return;
      toggle.setAttribute(
        "aria-label",
        paused
          ? "Reproducir el carrusel de testimonios"
          : "Pausar el carrusel de testimonios",
      );
      icon.textContent = paused ? "▶" : "❚❚";
    };

    const start = () => {
      stop();
      if (paused) return;
      timer = window.setInterval(() => {
        move(1, !reduceMotion.matches);
      }, AUTOPLAY_MS);
    };

    const pause = () => {
      paused = true;
      stop();
      syncToggle();
    };

    toggle?.addEventListener("click", () => {
      paused = !paused;
      syncToggle();
      if (paused) stop();
      else start();
    });

    track.addEventListener("scroll", normalize, { passive: true });
    track.addEventListener("pointerenter", stop);
    track.addEventListener("pointerleave", () => {
      if (!paused) start();
    });
    track.addEventListener("focusin", stop);
    track.addEventListener("focusout", () => {
      if (!paused) start();
    });

    let resumeHandle: number | null = null;
    const holdForInteraction = () => {
      stop();
      if (resumeHandle !== null) window.clearTimeout(resumeHandle);
      resumeHandle = window.setTimeout(() => {
        if (!paused) start();
      }, 10000);
    };
    track.addEventListener("pointerdown", holdForInteraction, {
      passive: true,
    });
    track.addEventListener("touchstart", holdForInteraction, {
      passive: true,
    });

    document
      .querySelectorAll<HTMLButtonElement>("[data-carousel]")
      .forEach((button) => {
        if (button.dataset.carousel === "toggle") return;
        button.addEventListener("click", () => {
          move(
            button.dataset.carousel === "next" ? 1 : -1,
            !reduceMotion.matches,
          );
          if (!paused) start();
        });
      });

    reduceMotion.addEventListener("change", (event) => {
      if (event.matches) pause();
      else {
        paused = false;
        syncToggle();
        start();
      }
    });

    syncToggle();
    start();
  }

  setupCarousel();
</script>
