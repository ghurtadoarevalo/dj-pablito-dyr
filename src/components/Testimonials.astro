---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { INSTAGRAM_PROFILE_URL, TESTIMONIALS } from "../data/testimonials";
import tamaritaandreaAvatar from "@assets/testimonials/tamaritaandrea.webp";
import moniquita36molinaAvatar from "@assets/testimonials/moniquita36molina.webp";
import jecaMoraAvatar from "@assets/testimonials/jeca_mora.webp";
import ceciliamolinalilloAvatar from "@assets/testimonials/ceciliamolinalillo.webp";
import sjesitoAvatar from "@assets/testimonials/sjesito.webp";
import luismolina153Avatar from "@assets/testimonials/luismolina153.webp";
import xmoraAvatar from "@assets/testimonials/xmora.b.webp";

const TRACK_ID = "testimonials-track";
const SLIDES = [...TESTIMONIALS, ...TESTIMONIALS];
const TOTAL = TESTIMONIALS.length;

const avatars: Record<string, ImageMetadata> = {
  "@tamaritaandrea": tamaritaandreaAvatar,
  "@moniquita36molina": moniquita36molinaAvatar,
  "@jeca_mora": jecaMoraAvatar,
  "@ceciliamolinalillo": ceciliamolinalilloAvatar,
  "@sjesito": sjesitoAvatar,
  "@luismolina153": luismolina153Avatar,
  "@xmora.b": xmoraAvatar,
};

const initial = (handle: string) =>
  handle.replace("@", "").trim().charAt(0).toUpperCase();
---

<section
  id="testimonios"
  aria-labelledby="testimonials-title"
  class="reveal border-t border-line bg-ink pt-8 pb-12 md:pt-10 md:pb-16"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        id="testimonials-title"
        title="Testimonios"
        lead="Comentarios públicos que dejaron en nuestro Instagram, sin editar."
      />
      <div class="mb-8 flex gap-2 md:mb-12">
        <button
          type="button"
          data-carousel="prev"
          data-target={TRACK_ID}
          aria-label="Testimonio anterior"
          aria-controls={TRACK_ID}
          class="grid size-11 place-items-center rounded-control border border-line-strong text-paper transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          data-carousel="next"
          data-target={TRACK_ID}
          aria-label="Testimonio siguiente"
          aria-controls={TRACK_ID}
          class="grid size-11 place-items-center rounded-control border border-line-strong text-paper transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true">→</span>
        </button>
        <button
          type="button"
          data-carousel="toggle"
          data-target={TRACK_ID}
          aria-label="Pausar el carrusel de testimonios"
          aria-controls={TRACK_ID}
          class="grid size-11 place-items-center rounded-control border border-line-strong text-paper transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true" data-carousel-icon>❚❚</span>
        </button>
      </div>
    </div>

    <ul
      id={TRACK_ID}
      role="region"
      aria-label="Testimonios de clientes"
      tabindex="0"
      class="no-scrollbar flex gap-4 overflow-x-auto pb-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      {
        SLIDES.map((testimonial, index) => (
          <li
            aria-hidden={index >= TOTAL ? "true" : undefined}
            class={`relative flex shrink-0 snap-start basis-[85%] flex-col justify-between rounded-card border bg-surface p-5 sm:basis-[48%] lg:basis-[32%] ${
              testimonial.highlighted ? "border-line-strong" : "border-line"
            }`}
          >
            <blockquote class="text-sm leading-relaxed text-paper">
              “{testimonial.quote}”
            </blockquote>
            <div class="mt-4 flex items-center gap-3">
              {avatars[testimonial.handle] ? (
                <Image
                  src={avatars[testimonial.handle]}
                  alt=""
                  aria-hidden="true"
                  width={72}
                  height={72}
                  loading="lazy"
                  class="size-9 shrink-0 rounded-pill border border-accent/40 object-cover"
                />
              ) : (
                <span
                  class="grid size-9 shrink-0 place-items-center rounded-pill border border-accent/40 bg-accent/10 font-display text-base leading-none text-accent"
                  aria-hidden="true"
                >
                  {initial(testimonial.handle)}
                </span>
              )}
              <p class="text-[11px] font-bold uppercase tracking-wide">
                <span class="text-accent">{testimonial.handle}</span>
                <span class="text-muted"> · {testimonial.context}</span>
                {index < TOTAL && (
                  <span class="sr-only">
                    {" "}
                    (testimonio {index + 1} de {TOTAL})
                  </span>
                )}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <a
        href={INSTAGRAM_PROFILE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-control border border-line-strong px-5 text-sm font-bold text-paper transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Ver más reseñas en Instagram
      </a>
    </div>
  </div>
</section>

<script>
  const SPEED_PX_PER_MS = 0.028;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function setupCarousel() {
    const track = document.getElementById("testimonials-track");
    if (!track) return;

    const slides = [...track.querySelectorAll("li")];
    const half = slides.length / 2;
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-carousel="toggle"]',
    );
    const icon = toggle?.querySelector<HTMLElement>("[data-carousel-icon]");
    let paused = reduceMotion.matches;
    let pausedByUser = reduceMotion.matches;
    let holding = false;
    let step = 0;
    let loopWidth = 0;
    let frame = 0;
    let lastTime = 0;
    let resumeHandle: number | null = null;

    const measure = () => {
      const card = slides[0];
      const gap = parseFloat(getComputedStyle(track).columnGap || "0");
      step = card ? card.getBoundingClientRect().width + gap : 0;
      loopWidth = step * half;
    };

    const wrap = () => {
      if (!loopWidth) return;
      if (track.scrollLeft >= loopWidth) {
        track.scrollLeft -= loopWidth;
      } else if (track.scrollLeft < 0) {
        track.scrollLeft += loopWidth;
      }
    };

    const tick = (now: number) => {
      const delta = lastTime ? now - lastTime : 0;
      lastTime = now;
      if (!paused && !holding && !reduceMotion.matches && delta < 200) {
        track.scrollLeft += SPEED_PX_PER_MS * delta;
        wrap();
      }
      frame = requestAnimationFrame(tick);
    };

    const syncToggle = () => {
      if (!toggle || !icon) return;
      toggle.setAttribute(
        "aria-label",
        pausedByUser
          ? "Reproducir el carrusel de testimonios"
          : "Pausar el carrusel de testimonios",
      );
      icon.textContent = pausedByUser ? "▶" : "❚❚";
    };

    const resumeSoon = () => {
      if (resumeHandle !== null) window.clearTimeout(resumeHandle);
      resumeHandle = window.setTimeout(() => {
        holding = false;
        lastTime = 0;
      }, 3000);
    };

    toggle?.addEventListener("click", () => {
      pausedByUser = !pausedByUser;
      paused = pausedByUser || reduceMotion.matches;
      lastTime = 0;
      syncToggle();
    });

    const hold = () => {
      holding = true;
      resumeSoon();
    };

    track.addEventListener("pointerenter", hold);
    track.addEventListener("pointerdown", hold, { passive: true });
    track.addEventListener("touchstart", hold, { passive: true });
    track.addEventListener("focusin", hold);
    track.addEventListener("pointerleave", resumeSoon);
    track.addEventListener("focusout", resumeSoon);

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-carousel="prev"], [data-carousel="next"]',
      )
      .forEach((button) => {
        button.addEventListener("click", () => {
          measure();
          track.scrollBy({
            left: (button.dataset.carousel === "next" ? 1 : -1) * step,
            behavior: reduceMotion.matches ? "auto" : "smooth",
          });
          hold();
        });
      });

    reduceMotion.addEventListener("change", (event) => {
      paused = pausedByUser || event.matches;
      lastTime = 0;
      if (!event.matches) syncToggle();
    });

    window.addEventListener("resize", measure, { passive: true });

    measure();
    syncToggle();
    frame = requestAnimationFrame(tick);
    window.addEventListener("pagehide", () => cancelAnimationFrame(frame));
  }

  setupCarousel();
</script>
