---
import SectionHeading from "./SectionHeading.astro";
import YoutubeVideo from "./YoutubeVideo.astro";

export interface YoutubeVideo {
  title: string;
  videoCode: string;
}

let videos: YoutubeVideo[] = [
  {
    title: "Mix 90's",
    videoCode: "ZlJ-w6fMHCI",
  },
  {
    title: "Mix Ke Personajes",
    videoCode: "qkDF_kRy05M",
  },
  {
    title: "Mix Dembow",
    videoCode: "gl2LmO2YcQo",
  },
  {
    title: "Mix Bachata",
    videoCode: "PkiSpb-QDt0",
  },
  {
    title: "Mix Rancheras",
    videoCode: "1jiZknX8nzw",
  },
  {
    title: "Mix Hip Hop",
    videoCode: "428MOaKB2qY",
  },
];
---

<section
  id="mixing"
  aria-labelledby="mixing-title"
  class="reveal border-t border-line bg-ink py-16 md:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      number="02"
      id="mixing-title"
      kicker="Nuestro sonido"
      title="Mixes"
      lead="Visítanos en YouTube y conoce nuestros mixes"
    />
    <ul
      class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 md:gap-6"
    >
      {
        videos.map(({ title, videoCode }: YoutubeVideo) => {
          return (
            <li class="w-[86%] shrink-0 snap-start sm:w-[62%] lg:w-[47%]">
              <YoutubeVideo {title} {videoCode} />
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
