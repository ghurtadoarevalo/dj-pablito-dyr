---
import SectionHeading from "./SectionHeading.astro";

export interface YoutubeVideo {
  title: string;
  videoCode: string;
}

const CHANNEL_URL = "https://www.youtube.com/@DVJPD";

const videos: YoutubeVideo[] = [
  { title: "Mix 90's", videoCode: "ZlJ-w6fMHCI" },
  { title: "Mix Ke Personajes", videoCode: "qkDF_kRy05M" },
  { title: "Mix Dembow", videoCode: "gl2LmO2YcQo" },
  { title: "Mix Bachata", videoCode: "PkiSpb-QDt0" },
  { title: "Mix Rancheras", videoCode: "1jiZknX8nzw" },
  { title: "Mix Hip Hop", videoCode: "428MOaKB2qY" },
];

const [featured, ...rest] = videos;
const thumb = (code: string) =>
  `https://img.youtube.com/vi/${code}/maxresdefault.jpg`;
---

<section
  id="mixing"
  aria-labelledby="mixing-title"
  class="reveal border-t border-line bg-ink py-10 md:py-14"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      number="02"
      id="mixing-title"
      kicker="Nuestro sonido"
      title="Mixes"
      lead="Sets completos grabados en vivo. Elegí el que va con tu fiesta y escuchalo en YouTube."
    />

    <div class="grid gap-6 lg:grid-cols-5 lg:gap-8">
      <a
        href={`https://www.youtube.com/watch?v=${featured.videoCode}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block aspect-video overflow-hidden rounded-card border border-line lg:col-span-3"
      >
        <img
          src={thumb(featured.videoCode)}
          alt={`${featured.title} de DJ Pablito Dyr`}
          loading="lazy"
          class="h-full w-full object-cover transition duration-reveal ease-reveal group-hover:scale-[1.03]"
        />
        <span
          class="absolute inset-0 block bg-gradient-to-t from-ink via-ink/35 to-transparent"
          aria-hidden="true"></span>
        <span
          class="absolute left-1/2 top-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-pill bg-accent text-xl text-ink shadow-xl transition duration-snap group-hover:scale-110"
          aria-hidden="true">▶</span
        >
        <span
          class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5"
        >
          <span
            class="font-display text-3xl uppercase leading-none tracking-tight text-white sm:text-4xl"
          >
            {featured.title}
          </span>
          <span
            class="hidden text-[10px] font-black uppercase tracking-[0.16em] text-accent sm:block"
          >
            Escuchar en YouTube
          </span>
        </span>
      </a>

      <ul class="flex flex-col divide-y divide-line lg:col-span-2">
        {
          rest.map((video, index) => (
            <li>
              <a
                href={`https://www.youtube.com/watch?v=${video.videoCode}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex min-h-14 items-center gap-4 py-3 text-white transition-colors duration-snap hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <span
                  class="w-6 shrink-0 text-[10px] font-black tracking-[0.1em] text-accent"
                  aria-hidden="true"
                >
                  {String(index + 2).padStart(2, "0")}
                </span>
                <span class="flex-1 text-sm font-bold uppercase tracking-wide">
                  {video.title}
                </span>
                <span
                  class="text-xs text-muted transition-transform duration-snap group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="text-[10px] font-bold uppercase tracking-wide text-muted">
        {videos.length} mixes · {videos.length} noches de fiesta
      </p>
      <a
        href={CHANNEL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-control border border-line-strong px-5 text-sm font-bold text-white transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Ver el canal en YouTube
      </a>
    </div>
  </div>
</section>
