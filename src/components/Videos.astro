---
import SectionHeading from "./SectionHeading.astro";

export interface YoutubeVideo {
  title: string;
  videoCode: string;
}

const CHANNEL_URL = "https://www.youtube.com/@VDJDP";

const videos: YoutubeVideo[] = [
  { title: "Mix 90's", videoCode: "ZlJ-w6fMHCI" },
  { title: "Mix Ke Personajes", videoCode: "qkDF_kRy05M" },
  { title: "Mix Dembow", videoCode: "gl2LmO2YcQo" },
  { title: "Mix Bachata", videoCode: "PkiSpb-QDt0" },
  { title: "Mix Rancheras", videoCode: "1jiZknX8nzw" },
  { title: "Mix Hip Hop", videoCode: "428MOaKB2qY" },
];

const thumb = (code: string) =>
  `https://img.youtube.com/vi/${code}/maxresdefault.jpg`;
const fallbackThumb = (code: string) =>
  `https://img.youtube.com/vi/${code}/hqdefault.jpg`;
---

<section
  id="mixing"
  aria-labelledby="mixing-title"
  class="reveal border-t border-line bg-ink py-12 md:py-20"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="mixing-title"
      title="Mixes"
      lead="Sets completos grabados en vivo. Se abren en YouTube, donde puedes escucharlos completos."
    />

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        videos.map((video) => (
          <li>
            <a
              href={`https://www.youtube.com/watch?v=${video.videoCode}`}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block aspect-video overflow-hidden rounded-card border border-line transition duration-snap hover:-translate-y-0.5 hover:border-line-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <img
                src={thumb(video.videoCode)}
                onerror={`this.onerror=null;this.src='${fallbackThumb(video.videoCode)}'`}
                alt={`${video.title} de DJ Pablito Dyr`}
                loading="lazy"
                class="h-full w-full object-cover transition duration-reveal ease-reveal group-hover:scale-[1.04]"
              />
              <span
                class="absolute inset-0 block bg-gradient-to-t from-ink via-ink/25 to-transparent"
                aria-hidden="true"
              />
              <span
                class="absolute left-1/2 top-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-pill bg-accent text-lg text-ink shadow-lg transition duration-snap group-hover:scale-110"
                aria-hidden="true"
              >
                ▶
              </span>
              <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4">
                <span class="font-display text-xl uppercase leading-none tracking-tight text-paper sm:text-2xl">
                  {video.title}
                </span>
                <span class="text-[11px] font-black uppercase tracking-[0.14em] text-accent">
                  YouTube
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="text-[11px] font-bold uppercase tracking-wide text-muted">
        {videos.length} mixes · {videos.length} noches de fiesta
      </p>
      <a
        href={CHANNEL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-control border border-line-strong px-5 text-sm font-bold text-paper transition-colors duration-snap hover:border-accent hover:text-accent-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Ver el canal en YouTube
      </a>
    </div>
  </div>
</section>
